# Supabase project settings (Project Settings -> API in the Supabase dashboard).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. NEVER prefix this with NEXT_PUBLIC_ and never import it from
# client code - it bypasses Row Level Security entirely. Used only for the
# contact-form rate-limit check/insert.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Secret pepper mixed into the hashed visitor IP stored with contact form
# submissions (defense-in-depth for rate limiting; never store raw IPs).
# Generate one with: openssl rand -hex 32
CONTACT_FORM_IP_PEPPER=change-me-to-a-random-secret

# Optional: enable transactional email notifications for new contact
# submissions (see src/lib/notifications/README.md). Leave unset to skip.
# RESEND_API_KEY=
# CONTACT_NOTIFICATION_TO_EMAIL=

# Base URL of the deployed site, used for sitemap.xml, canonical URLs, and
# Open Graph tags. Set to your production domain on Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
